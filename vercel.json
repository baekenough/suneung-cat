{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "python3 build_site.py",
  "outputDirectory": "web-dist",
  "regions": ["icn1"],
  "functions": {
    "api/leaderboard.js": {"maxDuration": 10}
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        {"key": "Vercel-CDN-Cache-Control", "value": "public, s-maxage=300"}
      ]
    },
    {
      "source": "/app/static/suneung-cat-og.jpg",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=3600"},
        {"key": "Vercel-CDN-Cache-Control", "value": "public, s-maxage=86400"}
      ]
    }
  ]
}
